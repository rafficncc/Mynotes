{
  "expo": {
    "name": "FamilyFin",
    "slug": "familyfin",
    "scheme": [
      "familyfin",
      "com.familyfin.app"
    ],
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.familyfin.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.familyfin.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B6E4F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 11,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#0B6E4F"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FamilyFin opens your photos only when you choose a bill to scan.",
          "cameraPermission": "FamilyFin uses the camera to scan your bills. Photos are read on your phone and never uploaded."
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-localization",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "FamilyFin uses the microphone only while you speak an expense.",
          "speechRecognitionPermission": "FamilyFin turns what you say into an expense entry."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "FamilyFin uses Face ID to unlock the app."
        }
      ],
      "expo-quick-actions",
      "expo-iap",
      "./plugins/optional-portrait"
    ],
    "extra": {
      "google": {
        "androidClientId": "735673334181-930sk0mp8mspqi2kikuo5b8autf0hidl.apps.googleusercontent.com",
        "iosClientId": "",
        "webClientId": "735673334181-c5ephpm3vutle2ea1db8nedgid4scib4.apps.googleusercontent.com"
      }
    }
  }
}
